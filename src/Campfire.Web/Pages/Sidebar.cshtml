@page "/users/me/sidebar"
@model SidebarModel
@{
    ViewData["Title"] = "Rooms";
    ViewData["BodyClass"] = "sidebar";
}
@section Sidebar {
    <partial name="Shared/_Sidebar" model="Model.Memberships" />
}
<div id="message-area" class="message-area">
    <div class="message-area--empty min-width center">
        <figure class="center pad">
            <img src="/assets/images/messages-empty.svg" alt="" class="colorize--black translucent">
        </figure>
    </div>
</div>
