@page "/users/me/sidebar"
@model SidebarModel
@{
    ViewData["Title"] = "Rooms";
}
<h1>Rooms</h1>
<ul id="sidebar" data-live>
    @foreach (var membership in Model.Memberships)
    {
        <li data-sidebar-room="@membership.RoomId">
            <a href="/rooms/@membership.RoomId">@(membership.Room.Name ?? "Direct")</a>
            @if (membership.Unread)
            {
                <span class="unread">unread</span>
            }
        </li>
    }
</ul>
