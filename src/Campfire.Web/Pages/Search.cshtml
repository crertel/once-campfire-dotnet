@page "/searches"
@model SearchModel
@{
    ViewData["Title"] = "Search";
}
<h1>Search</h1>
<form method="get" action="/searches">
    <label>Query <input name="q" value="@Model.Query" /></label>
    <button type="submit">Search</button>
</form>
<ul>
    @foreach (var message in Model.Results)
    {
        <li><a href="/rooms/@message.RoomId">@message.PlainText</a></li>
    }
</ul>
