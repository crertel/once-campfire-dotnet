@page "/first_run"
@model FirstRunModel
@{
    ViewData["Title"] = "Set up Campfire";
    ViewData["BodyClass"] = "signup";
    ViewData["Csrf"] = Model.Csrf;
    ViewData["Alert"] = Model.Error;
    var setup = new SetupForm(Model.Csrf, "/first_run");
}
<partial name="Shared/_SetupForm" model="setup" />
