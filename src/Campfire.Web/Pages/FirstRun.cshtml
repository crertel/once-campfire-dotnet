@page "/first_run"
@model FirstRunModel
@{
    ViewData["Title"] = "Set up Campfire";
}
<h1>Set up Campfire</h1>
@if (!string.IsNullOrEmpty(Model.Error))
{
    <p class="error">@Model.Error</p>
}
<form method="post">
    <label>Name <input name="user[name]" autocomplete="name" required /></label>
    <label>Email <input name="user[email_address]" type="email" autocomplete="email" required /></label>
    <label>Password <input name="user[password]" type="password" autocomplete="new-password" required /></label>
    <button type="submit">Create the campfire</button>
</form>
