@page "/account"
@model AccountModel
@using Campfire.Core
@{
    ViewData["Title"] = "Account settings";
    var account = Model.Account;
    var admin = Model.CurrentUser?.IsAdministrator == true;
    InviteForm? invite = account is null ? null : new InviteForm(account.JoinCode, $"{Request.Scheme}://{Request.Host}/join/{account.JoinCode}", admin);
}
@section Nav {
    <div class="flex-item-justify-start">
        <a class="btn" href="/">
            <img src="/assets/images/arrow-left.svg" alt="" width="20" height="20">
            <span class="for-screen-reader">Go Back</span>
        </a>
    </div>
    @if (admin)
    {
        <div class="flex align-center gap flex-item-justify-end">
            <a class="btn" href="/account/bots">
                <img src="/assets/images/bot.svg" alt="" width="20" height="20">
                <span class="for-screen-reader">Set up chat bots</span>
            </a>
            <a class="btn" href="#custom-styles">
                <img src="/assets/images/art.svg" alt="" width="20" height="20">
                <span class="for-screen-reader">Custom styles</span>
            </a>
        </div>
    }
}
@if (account is not null)
{
    <section class="panel txt-align-center flex flex-column gap">
        <h1 class="flex-item-grow txt-x-large">@account.Name</h1>
        @if (admin)
        {
            <form method="post" action="/account/logo" enctype="multipart/form-data" class="flex align-center gap center">
                <label class="btn avatar">
                    <img src="/account/logo?v=@account.UpdatedAt.Ticks" alt="Account logo" width="64" height="64">
                    <input type="file" name="logo" accept="image/png,image/jpeg,image/gif,image/webp">
                    <span class="for-screen-reader">Upload account logo</span>
                </label>
                <button class="btn" type="submit">Save logo</button>
            </form>
            <form method="post" action="/account/logo/remove">
                <button class="btn" type="submit">
                    <img src="/assets/images/remove.svg" alt="" width="20" height="20">
                    <span class="for-screen-reader">Remove logo</span>
                </button>
            </form>
        }
        <div class="margin-block pad-inline pad-block-start fill-shade border-radius">
            <partial name="Shared/_Invite" model="invite" />
            <hr class="margin-block separator full-width" style="--border-style: solid">
            <menu class="flex flex-column gap margin-none pad">
                @{
                    var listed = Model.Users.Where(person => person.Role != UserRole.Bot && person.Status != UserStatus.Deactivated);
                    if (!admin)
                        listed = listed.Where(person => person.Status == UserStatus.Active);
                    var administrators = listed.Where(person => person.IsAdministrator).OrderBy(person => person.Name).ToList();
                    var members = listed.Where(person => !person.IsAdministrator).OrderBy(person => person.Name).ToList();
                }
                @foreach (var person in administrators)
                {
                    <partial name="Shared/_AccountUser" model="person" />
                }
                @if (administrators.Count > 0 && members.Count > 0)
                {
                    <hr class="separator full-width" style="--border-style: solid">
                }
                @foreach (var person in members)
                {
                    <partial name="Shared/_AccountUser" model="person" />
                }
            </menu>
        </div>
        @if (admin)
        {
            <form method="post" id="custom-styles" class="flex flex-column gap">
                <input type="hidden" name="settings" value="1">
                <div class="margin-block-start pad-block pad-inline-double fill-shade border-radius">
                    <div class="flex align-center gap center">
                        <div class="flex-item-grow flex align-center gap txt-align-start">
                            <img src="/assets/images/crown.svg" class="colorize--black" alt="" width="18" height="18">
                            Must be admin to create new rooms
                        </div>
                        <label class="switch">
                            @if (account.RestrictRoomCreationToAdministrators)
                            {
                                <input class="switch__input" type="checkbox" name="restrict" value="1" checked>
                            }
                            else
                            {
                                <input class="switch__input" type="checkbox" name="restrict" value="1">
                            }
                            <span class="switch__btn round"></span>
                            <span class="for-screen-reader">Must be admin to create new rooms</span>
                        </label>
                    </div>
                </div>
                <h2 class="margin-none">Custom CSS</h2>
                <p class="margin-none-block-start">Add custom CSS styles. Use caution: you could break things.</p>
                <label class="flex align-start gap flex-item-grow">
                    <textarea class="input input--code txt--small" name="custom_styles" rows="8" placeholder="Add CSS styles…" spellcheck="false">@account.CustomStyles</textarea>
                </label>
                <button class="btn btn--reversed center txt-large" type="submit">
                    <img src="/assets/images/check.svg" alt="" width="20" height="20">
                    <span class="for-screen-reader">Save changes</span>
                </button>
            </form>
        }
    </section>
}
@section Footer {
    <div class="txt-align-center center margin-block-double txt-subtle">Campfire</div>
}
