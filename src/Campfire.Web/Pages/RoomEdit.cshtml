@page "/rooms/{kind}/{id:long}/edit"
@model RoomEditModel
@using Campfire.Core
@{
    ViewData["Title"] = Model.Room?.Name ?? "Room settings";
    var room = Model.Room;
    var direct = Model.Kind == "directs";
    var open = Model.Kind == "opens";
    var canEdit = Model.CurrentUser?.IsAdministrator == true || Model.CurrentUser?.Id == room?.CreatorId;
}
@section Nav {
    <div class="flex-item-justify-start">
        <a class="btn" href="/rooms/@room?.Id">
            <img src="/assets/images/arrow-left.svg" alt="" width="20" height="20">
            <span class="for-screen-reader">Go Back</span>
        </a>
    </div>
}
@if (room is not null)
{
    <section class="panel txt-align-center">
        @if (direct)
        {
            <h1 class="txt-large">@MessageMarkup.RoomLabel(room, Model.CurrentUser?.Id ?? 0)</h1>
            <ul class="flex flex-column gap margin-none pad">
                @foreach (var membership in room.Memberships)
                {
                    <li class="flex align-center gap">
                        <img src="@MessageMarkup.AvatarUrl(membership.User)" alt="" width="32" height="32">
                        <span>@membership.User.Name</span>
                    </li>
                }
            </ul>
        }
        else
        {
            <form method="post" class="flex flex-column gap">
                @if (canEdit)
                {
                    <label class="flex-item-grow txt-large">
                        <input class="input full-width" name="room[name]" value="@room.Name" required>
                        <span class="for-screen-reader">Name this room</span>
                    </label>
                }
                else
                {
                    <h1 class="txt-x-large">@room.Name</h1>
                }
                <section class="room-access margin-block pad-inline fill-shade border-radius">
                    <ul class="flex flex-column gap margin-none pad">
                        @if (canEdit)
                        {
                            <li class="flex align-center gap">
                                <img src="/assets/images/everyone.svg" alt="" width="32" height="32" class="colorize--black">
                                <div class="min-width"><strong>Everyone</strong></div>
                                <a class="btn--faux flex-inline" href="@(open ? $"/rooms/closeds/{room.Id}/edit" : $"/rooms/opens/{room.Id}/edit")">
                                    <label class="switch">
                                        <input type="checkbox" class="switch__input" @(open ? "checked" : "") disabled>
                                        <span class="switch__btn round"></span>
                                        <span class="for-screen-reader">@(open ? "Give only some access to this room" : "Give everyone access to this room")</span>
                                    </label>
                                </a>
                            </li>
                        }
                        @if (!open)
                        {
                            <li><input class="input full-width" type="search" placeholder="Filter people" data-filter></li>
                            @foreach (var person in Model.People)
                            {
                                <li class="flex align-center gap" data-name="@person.Name">
                                    <label class="flex align-center gap flex-item-grow">
                                        <input type="checkbox" name="user_ids" value="@person.Id" @(Model.Selected.Contains(person.Id) ? "checked" : "") @(canEdit ? "" : "disabled")>
                                        <img src="@MessageMarkup.AvatarUrl(person)" alt="" width="32" height="32">
                                        <span>@person.Name</span>
                                    </label>
                                </li>
                            }
                        }
                    </ul>
                </section>
                @if (!string.IsNullOrEmpty(Model.Error))
                {
                    <p role="alert">@Model.Error</p>
                }
                @if (canEdit)
                {
                    <button class="btn btn--reversed center txt-large" type="submit">
                        <img src="/assets/images/check.svg" alt="" width="20" height="20">
                        <span class="for-screen-reader">Save changes</span>
                    </button>
                }
            </form>
        }
        @if (canEdit)
        {
            <form method="post" action="/rooms/@room.Id/delete">
                <button class="btn" type="submit">
                    <img src="/assets/images/remove.svg" alt="" width="20" height="20">
                    <span class="for-screen-reader">Delete this @(direct ? "ping" : "room")</span>
                </button>
            </form>
        }
    </section>
}
