@page "/users/me/profile"
@model ProfileModel
@{
    ViewData["Title"] = "Profile";
}
<h1>Profile</h1>
<form method="post">
    <label>Name <input name="name" value="@Model.CurrentUser?.Name" /></label>
    <label>Email <input name="email_address" value="@Model.CurrentUser?.EmailAddress" /></label>
    <label>Bio <textarea name="bio">@Model.CurrentUser?.Bio</textarea></label>
    <label>New password <input name="password" type="password" /></label>
    <button type="submit">Save</button>
</form>
<form method="post" action="/users/@Model.CurrentUser!.Id/avatar" enctype="multipart/form-data" asp-antiforgery="false">
    <label>Avatar <input type="file" name="avatar" accept="image/png,image/jpeg,image/gif,image/webp" /></label>
    <button type="submit">Upload avatar</button>
</form>
@if (Model.CurrentUser?.Avatar is not null)
{
    <img src="/users/@Model.CurrentUser.Id/avatar" alt="" />
}
<form method="post" action="/session/logout" asp-antiforgery="false">
    <button type="submit">Sign out</button>
</form>
