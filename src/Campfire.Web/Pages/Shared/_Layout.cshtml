@{
    var account = Context.Items["Account"] as Account;
    var user = Context.Items["User"] as User;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? account?.Name ?? "Campfire")</title>
    <style>
        :root { color-scheme: light; --ink: #1c1917; --paper: #faf7f2; --ember: #c2410c; --line: #e7e0d6; }
        body { margin: 0; font: 16px/1.45 Georgia, "Iowan Old Style", serif; color: var(--ink); background: var(--paper); }
        header { display: flex; justify-content: space-between; align-items: center; padding: 0.75rem 1.25rem; border-bottom: 1px solid var(--line); }
        header a { color: inherit; text-decoration: none; }
        main { max-width: 46rem; margin: 0 auto; padding: 1.25rem; }
        form { display: grid; gap: 0.75rem; }
        input, textarea, button { font: inherit; }
        input, textarea { padding: 0.55rem 0.7rem; border: 1px solid var(--line); border-radius: 0.4rem; background: white; }
        button, .button { background: var(--ember); color: white; border: 0; border-radius: 0.4rem; padding: 0.55rem 0.9rem; text-decoration: none; }
        .message { padding: 0.75rem 0; border-bottom: 1px solid var(--line); }
        .author { margin: 0; font-weight: bold; }
        .error { color: #9f1239; }
        textarea { min-height: 5rem; }
    </style>
    @if (!string.IsNullOrEmpty(account?.CustomStyles))
    {
        <style>@account.CustomStyles</style>
    }
</head>
<body>
    <header>
        <a href="/">@(account?.Name ?? "Campfire")</a>
        @if (user is not null)
        {
            <nav>
                <a href="/users/me/sidebar">Rooms</a>
                <a href="/searches">Search</a>
                <a href="/users/me/profile">@user.Name</a>
            </nav>
        }
    </header>
    <main>
        @RenderBody()
    </main>
    <script src="/js/signalr.min.js"></script>
    <script src="/js/campfire.js"></script>
</body>
</html>
